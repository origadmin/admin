# .env.system
# You can define environment-specific variables here.
# For example:
# DB_USER=admin
# DB_PASSWORD=123456
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=origadmin

# GRPC_PORT=9001
# HTTP_PORT=8001

# .env.initializer
# You can define environment-specific variables here.
# For example:
# INITIALIZER_PORT=8080

DATABASE_DIALECT=postgres
DATABASE_SOURCE=postgres://user:password@127.0.0.1:5432/origadmin?sslmode=disable
NATS_HOST=localhost
NATS_PORT=14222